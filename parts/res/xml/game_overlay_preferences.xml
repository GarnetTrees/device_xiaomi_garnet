<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto">

    <SwitchPreference
        android:key="game_overlay_enable"
        android:title="Включить Игровую Панель"
        android:summary="@string/game_overlay_summary"
        android:defaultValue="false" />

    <PreferenceCategory
        android:title="Overlay Features"
        android:dependency="game_overlay_enable">

        <SwitchPreference
            android:key="game_overlay_fps_enable"
            android:title="Наложение кадров в секунду"
            android:summary="Отображение текущего значения FPS на экране"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="game_overlay_temp_enable"
            android:title="Температура устройства"
            android:summary="Отображение температуры устройства (батареи)"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="game_overlay_cpu_usage_enable"
            android:title="Использование процессора"
            android:summary="Отображение текущего процента загрузки процессора"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="game_overlay_cpu_clock_enable"
            android:title="Тактовые частоты процессора"
            android:summary="Отображение текущей тактовой частоты процессора для каждого ядра"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="game_overlay_cpu_temp_enable"
            android:title="Температура процессора"
            android:summary="Показывать температуру процессора (thermal_zone0)"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="game_overlay_ram_enable"
            android:title="Использование оперативной памяти"
            android:summary="Показывает текущее использование оперативной памяти в МБ"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="game_overlay_gpu_usage_enable"
            android:title="Использование графического процессора"
            android:summary="Отображение процента использования графического процессора"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="game_overlay_gpu_clock_enable"
            android:title="Тактовая частота графического процессора"
            android:summary="Отображение текущей тактовой частоты графического процессора"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="game_overlay_gpu_temp_enable"
            android:title="Температура графического процессора"
            android:summary="Отображение текущей температуры графического процессора"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Кастомизация"
        android:dependency="game_overlay_enable">

        <SeekBarPreference
            android:key="game_overlay_text_size"
            android:title="Размер текста"
            android:summary="Отрегулируйте размер наложенного текста"
            android:defaultValue="16"
            android:max="32"
            android:min="12" />

        <SeekBarPreference
            android:key="game_overlay_background_alpha"
            android:title="Прозрачность фона"
            android:summary="Отрегулируйте прозрачность фона"
            android:defaultValue="128"
            android:max="255"
            android:min="0" />

        <SeekBarPreference
            android:key="game_overlay_corner_radius"
            android:title="Радиус угла наложения"
            android:summary="Отрегулируйте, насколько закругленными должны быть углы наложения"
            android:defaultValue="16"
            android:max="100"
            android:min="0" />

        <SeekBarPreference
            android:key="game_overlay_padding"
            android:title="Накладываемое заполнение"
            android:summary="Отрегулируйте пространство вокруг статистики"
            android:defaultValue="12"
            android:max="64"
            android:min="0" />

        <SeekBarPreference
            android:key="game_overlay_item_spacing"
            android:title="Расстояние между элементами"
            android:summary="Отрегулируйте расстояние между линиями наложения"
            android:defaultValue="8"
            android:max="50"
            android:min="0" />

        <ListPreference
            android:key="game_overlay_update_interval"
            android:title="Интервал обновления"
            android:summary="Установите, как часто обновляются значения наложения"
            android:defaultValue="1000"
            android:entries="@array/fps_overlay_update_interval_entries"
            android:entryValues="@array/fps_overlay_update_interval_values" />

        <ListPreference
            android:key="game_overlay_title_color"
            android:title="Цвет заголовка статистики"
            android:summary="Цвет текста 'FPS', 'Temp', 'CPU' и т.д."
            android:defaultValue="#FFFFFF"
            android:entries="@array/fps_overlay_color_entries"
            android:entryValues="@array/fps_overlay_color_values" />

        <ListPreference
            android:key="game_overlay_value_color"
            android:title="Цвет статистического значения"
            android:summary="Цвет для числовых значений (например, '29', '32,0°C')"
            android:defaultValue="#4CAF50"
            android:entries="@array/fps_overlay_color_entries"
            android:entryValues="@array/fps_overlay_color_values" />

        <ListPreference
            android:key="game_overlay_position"
            android:title="Положение наложения"
            android:summary="Выберите положение наложения на экране"
            android:defaultValue="top_left"
            android:entries="@array/fps_overlay_position_entries"
            android:entryValues="@array/fps_overlay_position_values" />

        <ListPreference
            android:key="game_overlay_format"
            android:title="Формат наложения"
            android:summary="Выберите между полным или минимальным отображением"
            android:defaultValue="full"
            android:entries="@array/game_overlay_format_entries"
            android:entryValues="@array/game_overlay_format_values" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Разделенная конфигурация"
        android:dependency="game_overlay_enable">

        <ListPreference
            android:key="game_overlay_split_mode"
            android:title="Разделенный режим"
            android:summary="Выбирайте расположение бок о бок или штабелями"
            android:defaultValue="stacked"
            android:entries="@array/game_overlay_split_mode_entries"
            android:entryValues="@array/game_overlay_split_mode_values" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Наложение элементов управления жестами"
        android:dependency="game_overlay_enable">

        <SwitchPreference
            android:key="game_overlay_single_tap_toggle"
            android:title="Включите переключение одним нажатием"
            android:summary="Нажмите один раз, чтобы переключиться между полным и минимальным форматами наложения"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="game_overlay_doubletap_capture"
            android:title="Включите двойное касание для захвата"
            android:summary="Дважды коснитесь наложения, чтобы запустить / остановить запись журналов"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="game_overlay_longpress_enable"
            android:title="Включить длительное нажатие"
            android:summary="Длительное нажатие кнопки overlay для доступа к настройкам игровой панели"
            android:defaultValue="false" />

        <ListPreference
            android:key="game_overlay_longpress_timeout"
            android:title="Длительное нажатие"
            android:summary="Установите продолжительность, необходимую для длительного нажатия на оверлей"
            android:defaultValue="1000"
            android:entries="@array/game_overlay_longpress_entries"
            android:entryValues="@array/game_overlay_longpress_values"
            android:dependency="game_overlay_longpress_enable" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Захват журналов"
        android:dependency="game_overlay_enable">

        <Preference
            android:key="game_overlay_capture_start"
            android:title="Начать ведение журнала"
            android:summary="Начните собирать данные о частоте кадров в секунду и производительности в режиме реального времени" />

        <Preference
            android:key="game_overlay_capture_stop"
            android:title="Прекратить ведение журнала"
            android:summary="Прекратите фиксировать частоту кадров в секунду и данные о производительности в режиме реального времени" />

        <Preference
            android:key="game_overlay_capture_export"
            android:title="Экспорт данных журнала игровой панели"
            android:summary="Сохраните полученные данные о частоте кадров в секунду и производительности в виде CSV-файла" />
    </PreferenceCategory>

</PreferenceScreen>
